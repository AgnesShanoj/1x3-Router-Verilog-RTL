module router_fifo_tb();

    reg clk, rst_n, write_enb, soft_reset, read_enb, lfd_state;
    reg [7:0] data_in;
    wire empty, full;
    wire [7:0] data_out;

    integer k;

    router_fifo DUT (clk, rst_n, write_enb, soft_reset, read_enb, data_in, lfd_state, empty, data_out, full);

    always begin
        #10; clk = 1'b0;
        #10; clk = ~clk;
    end

    task reset_dut();
    begin
        @(negedge clk);
        rst_n = 1'b0;
        @(negedge clk);
        rst_n = 1'b1;
    end
    endtask

    task soft_reset_dut();
    begin
        @(negedge clk);
        soft_reset = 1'b1;
        @(negedge clk);
        soft_reset = 1'b0;
    end
    endtask

    task write();
        reg [7:0] header, payload, parity;
        reg [5:0] payload_len;
        reg [1:0] addr;
    begin
        @(negedge clk);
        payload_len = 6'd14;
        addr = 2'b01;
        lfd_state = 1'b1;
        write_enb = 1'b1;
        header = {payload_len, addr};
        data_in = header;
        for(k=0; k<payload_len; k=k+1)
        begin
            @(negedge clk);
            lfd_state = 1'b0;
            payload = {$random}%256;
            data_in = payload;
        end
        @(negedge clk);
        parity = {$random}%256;
        data_in = parity;
    end
    endtask

    task read(input r, input w);
    begin
        @(negedge clk);
        read_enb = r;
        write_enb = w;
    end
    endtask

    initial begin
        reset_dut();
        write();
        repeat(16) read(1, 0);
        #4000 $finish;
    end

endmodule
