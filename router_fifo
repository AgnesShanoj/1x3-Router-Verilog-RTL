module router_fifo(clk,rst_n,write_enb,soft_reset,read_enb,data_in,lfd_state,empty,data_out,full);
 input clk,rst_n,write_enb,soft_reset,read_enb,lfd_state;
 input [7:0] data_in;
 output empty,full;
 output reg [7:0] data_out;
 reg [6:0] count;
 reg [8:0] mem [0:15];
 reg [4:0] rd_ptr,wr_ptr;
 integer i;

 always@(posedge clk,negedge rst_n)
  begin
   if(!rst_n)
    count <= 7'b0;
   else if(soft_reset)
    count <= 7'h0;
   else if (read_enb && ~empty)
    begin
     // FIXED: Changed parentheses () to square brackets [] for mem indexing
     if(mem[rd_ptr[3:0]][0] == 1'b1)
      count <= mem[rd_ptr[3:0]][7:2] + 7'h1;
     else if(count != 7'h0) // Fixed structural indentation/scoping
      count <= count - 7'h1;
    end
  end

 always@(posedge clk, negedge rst_n)
  begin 
   if(!rst_n)
    begin 
     data_out <= 8'h0;
     rd_ptr   <= 5'h0;
    end
   else if(soft_reset)
    begin
     data_out <= 8'h0;
     rd_ptr   <= 5'h0;
    end
   // FIXED: Changed 0'h0 to 8'h0
   else if ((count == 7'h0) && (data_out != 8'h0))
    data_out <= 8'hz;
   else if(read_enb && ~empty)
    begin
     data_out <= mem[rd_ptr[3:0]][7:0]; // Note: mem is 9 bits wide, data_out is 8 bits
     rd_ptr   <= rd_ptr + 5'h1;
    end
  end

 always@(posedge clk,negedge rst_n)
  begin
   if(!rst_n)
    begin
     wr_ptr <= 5'h0;
     for(i=0; i<16; i=i+1)
      mem[i] <= 9'd0;
    end
   else if(soft_reset)
    begin
     wr_ptr <= 5'h0;
     for(i=0; i<16; i=i+1)
      mem[i] <= 9'd0;
    end
   else if (write_enb && ~full)
    begin
     mem[wr_ptr[3:0]] <= {lfd_state, data_in};
     wr_ptr <= wr_ptr + 5'h1;
    end
  end

 assign empty = (rd_ptr == wr_ptr);
 assign full  = (wr_ptr == {~rd_ptr[4], rd_ptr[3:0]});

endmodule
